# species mean dry biomass  timeseries
ggplot(biomass_clean) +
aes(x = start_of_year,
y = mean_dry_gm2,
color = common_name) +
geom_line() +
geom_point(size = 0.5) +
scale_x_date(date_breaks = "3 years",
date_labels = "%Y") +
scale_color_manual(values = c(
"Giant Kelp" = "seagreen",
"California Sheephead" = "dodgerblue4",
"Purple Urchin" = "purple",
"Red Urchin" = "firebrick")) +
labs(
x = "Time (years)",
y = "Mean dry biomass (g/m^2)") +
theme_minimal() +
theme(legend.position = "NONE")
