# cleaning names
clean_names() |>
# filter for desired species
filter(common_name %in% c("California Sheephead",
"Red Urchin",
"Purple Urchin",
"Giant Kelp")) |>
# selecting for dry mass and common name
select(dry_gm2, common_name) |>
# using gg_miss_var to check for "na" data for species
gg_miss_var(facet = common_name)
# Chunk 3: visualizing-missing-bottom-temp-data
#| label: visualizing-missing-bottom-temp-data
# looking at the missing temperature data
bottom_temp |>
clean_names() |>
# filter for fish
select(temp_c) |>
# using gg_miss_var to check for "na" data
gg_miss_var()
# Chunk 4: visualizing-missing-bottom-temp-data
#| label: visualizing-missing-bottom-temp-data
# looking at the missing temperature data
sst |>
clean_names() |>
# filter for fish
select(temp) |>
# using gg_miss_var to check for "na" data
gg_miss_var()
# Chunk 5: cleaning-data
#| label: cleaning-data
# BIOMASS
# creating new object, biomass_clean
biomass_clean <- biomass |>
# cleaning names
clean_names() |>
# filtering for desired species
filter(common_name %in% c("California Sheephead",
"Red Urchin",
"Purple Urchin",
"Giant Kelp")) |>
# renaming date
rename(original_date = date) |>
# using mutate and lubridate to convert original_date
# into new date column that can be used to create time series
mutate(
date = ymd(original_date),
year = floor_date(date, unit = "year")) |>
# dropping na values to use summarize
drop_na(dry_gm2) |>
# grouping data by year and species
group_by(year,
common_name) |>
# using summarize to get the mean dry biomass and make one row per year
summarize(mean_dry_gm2 = mean(dry_gm2)) |>
# ungrouping data
ungroup() |>
# relocating columns to left to look at
relocate(common_name, year, mean_dry_gm2)
# BOTTOM TEMPERATURE
# creating new object to look at bottom temp data
bottom_temp_clean <- bottom_temp |>
# cleaning names
clean_names() |>
# using mutate and lubridate to convert date_local
# into new date column that can be used to create time series
mutate(
date = ymd(date_local),
year = floor_date(date, unit = "year")) |>
# grouping data by year
group_by(year) |>
# using summarize to get mean temp and make one row per year
summarize(mean_bottom_temp = mean(temp_c)) |>
# ungrouping the data
ungroup() |>
# relocating desired columns to left side
relocate(year, mean_bottom_temp)
# SEA SURFACE TEMPERATURE
# creating new object to look at sea surface temp data
sst_clean <- sst |>
# cleaning names
clean_names() |>
# using mutate and lubridate to convert date_local
# into new date column that can be used to create time series
mutate(
date = ymd(date),
year = floor_date(date, unit = "year")) |>
# grouping data by year
group_by(year) |>
# using summarize to get mean temp and make one row per year
summarize(mean_sst_temp = mean(temp)) |>
# ungrouping the data
ungroup() |>
# relocating desired columns to left side
relocate(year, mean_sst_temp)
# Chunk 6: joining-datasets
#| label: joining-datasets
# creating new object to join datasets
biomass_and_bottom_temp <- full_join(
biomass_clean,
bottom_temp_clean,
# joining datasets by year
by = c("year"))
biomass_all_temps <- full_join(
biomass_and_bottom_temp,
sst_clean,
by =c("year"))
# Chunk 7: visualizing-species-abundance-through-time
#| label: visualizing-species-abundance-through-time
# species mean dry biomass timeseries NO FACET
# base layer: ggplot
ggplot(biomass_and_bottom_temp) +
# year on x axis, biomass on y axis, coloring by species
aes(x = year,
y = mean_dry_gm2,
color = common_name) +
# first layer: geom_line
geom_line() +
# second layer: geom_point
geom_point(size = 0.5) +
# customizing x axis year labels for every 3 years
scale_x_date(date_breaks = "3 years",
date_labels = "%Y") +
# customizing colors
scale_color_manual(values = c(
"Giant Kelp" = "seagreen",
"California Sheephead" = "dodgerblue4",
"Purple Urchin" = "purple",
"Red Urchin" = "firebrick")) +
# using labs to label axes
labs(
x = "Time (years)",
y = "Mean dry biomass (g/m^2)") +
# adding custom theme
theme_minimal() +
# removing axis
theme(legend.position = "NONE")
# Chunk 8
# species mean dry biomass timeseries FACET
# base layer: ggplot
ggplot(biomass_and_bottom_temp) +
# year on x axis, biomass on y axis, coloring by species
aes(x = year,
y = mean_dry_gm2,
color = common_name) +
# first layer: geom_line
geom_line() +
# second layer: geom_point
geom_point(size = 0.5) +
# faceting by species
facet_wrap(~ common_name,
# letting y axis adjust for each species
scales = "free_y",
# putting in one column for better viewing
ncol = 1) +
# customizing x axis year labels for every 3 years
scale_x_date(date_breaks = "3 years",
date_labels = "%Y") +
# customizing colors
scale_color_manual(values = c(
"Giant Kelp" = "seagreen",
"California Sheephead" = "dodgerblue4",
"Purple Urchin" = "purple",
"Red Urchin" = "firebrick")) +
# using labs to label axes
labs(
x = "Time (years)",
y = "Mean dry biomass (g/m^2)") +
# adding custom theme
theme_minimal() +
# removing axis
theme(legend.position = "NONE")
# Chunk 9
# time series mean temperature
