library(tidyverse) # general use
library(janitor) # cleaning data
library(here) # data organization
library(lubridate) # date and time
library(naniar) # to use gg_miss_var
library(zoo) # to identify warming period
# reading in biomass data
biomass <- read.csv(here("data",
"annual_all_species_fish.csv"),
# changing -99999 values to be na
na = "-99999")
# reading in sea surface temperature data for if I want to use it
sst <- read.csv(here("data", "SST_update2023.csv"),
na = "-99999")
# reading in bottom temperature data
bottom_temp <- read.csv(here("data", "Bottom_temp_all_years.csv"),
# changing -99999 values to be na
na = "-99999")
#| label: warming-period
warming_period <- biomass_and_bottom_temp |>
mutate(
roll_3 = rollmean(mean_bottom_temp, k = 3, fill = NA, allign = "left")
start_year = year,
#| label: warming-period
warming_period <- biomass_and_bottom_temp |>
mutate(
roll_3 = rollmean(mean_bottom_temp, k = 3, fill = NA, allign = "left"),
start_year = year,
end_year = year + 2)
#| label: warming-period
warming_period <- biomass_and_bottom_temp |>
mutate(
roll_3 = rollmean(mean_bottom_temp, k = 3, fill = NA, allign = "left"),
start_year = year,
end_year = year + 2)
warming_period |>
filter(roll_3 == max(roll_3)) |>
select(start_ear, end_year, roll_3)
#| label: warming-period
warming_period <- biomass_and_bottom_temp |>
mutate(
roll_3 = rollmean(mean_bottom_temp, k = 3, fill = NA, allign = "left"),
start_year = year,
end_year = year + 2)
warming_period |>
filter(roll_3 == max(roll_3)) |>
select(start_year, end_year, roll_3)
#| label: warming-period
warming_period <- biomass_and_bottom_temp |>
mutate(
roll_3 = rollmean(mean_bottom_temp, k = 3, fill = NA, allign = "left"),
start_year = year,
end_year = year + 2)
warming_period |>
filter(roll_3 == max(roll_3)) |>
select(start_year, end_year, roll_3)
warming_period
#| label: warming-period
warming_period <- biomass_and_bottom_temp |>
mutate(
roll_3 = rollmean(mean_bottom_temp, k = 3, fill = NA, allign = "left"),
start_year = year,
end_year = year + 2)
warming_period |>
filter(roll_3 == max(roll_3, na.rm = TRUE)) |>
select(start_year, end_year, roll_3)
warming_period
View(warming_period)
