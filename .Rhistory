mutate(
date = ymd(date_local),
year = floor_date(date, unit = "year")) |>
# grouping data by year
group_by(year) |>
# using summarize to get mean temp and make one row per year
summarize(mean_bottom_temp = mean(temp_c)) |>
# ungrouping the data
ungroup() |>
# relocating desired columns to left side
relocate(year, mean_bottom_temp)
# SEA SURFACE TEMPERATURE
# creating new object to look at sea surface temp data
sst_clean <- sst |>
# cleaning names
clean_names() |>
# using mutate and lubridate to convert date_local
# into new date column that can be used to create time series
mutate(
date = ymd(date),
year = floor_date(date, unit = "year")) |>
# grouping data by year
group_by(year) |>
# using summarize to get mean temp and make one row per year
summarize(mean_sst_temp = mean(temp)) |>
# ungrouping the data
ungroup() |>
# relocating desired columns to left side
relocate(year, mean_sst_temp)
#| label: joining-datasets
# creating new object to join datasets
biomass_and_bottom_temp <- full_join(
biomass_clean,
bottom_temp_clean,
# joining datasets by year
by = c("year"))
biomass_all_temps <- full_join(
biomass_and_bottom_temp,
sst_clean,
by =c("year"))
#| label: visualizing-species-abundance-through-time
# species mean dry biomass timeseries NO FACET
# base layer: ggplot
ggplot(biomass_and_bottom_temp) +
# year on x axis, biomass on y axis, coloring by species
aes(x = year,
y = mean_dry_gm2,
color = common_name) +
# first layer: geom_line
geom_line() +
# second layer: geom_point
geom_point(size = 0.5) +
# customizing x axis year labels for every 3 years
scale_x_date(date_breaks = "3 years",
date_labels = "%Y") +
# customizing colors
scale_color_manual(values = c(
"Giant Kelp" = "seagreen",
"California Sheephead" = "dodgerblue4",
"Purple Urchin" = "purple",
"Red Urchin" = "firebrick")) +
# using labs to label axes
labs(
x = "Time (years)",
y = "Mean dry biomass (g/m^2)") +
# adding custom theme
theme_minimal() +
# removing axis
theme(legend.position = "NONE")
# species mean dry biomass timeseries FACET
