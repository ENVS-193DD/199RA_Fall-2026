#| label: biomass-timeseries
# base layer: ggplot
ggplot(data = biomass_clean,
# year on x axis, mean dry biomass on y
# coloring by species name
mapping = aes(x = year,
y = mean_dry_gm2,
fill = common_name,
color = common_name)) +
geom_area(alpha = 0.8) +
# second layer: geom_point
geom_line() +
# faceting by species
facet_wrap(~ common_name,
# letting y axis adjust for each species
scales = "free_y",
# putting in one column for better viewing
ncol = 1) +
# customizing x axis year labels for every 3 years
scale_x_date(date_breaks = "5 years",
date_labels = "%Y") +
# customizing colors
scale_color_manual(values = c(
"Giant Kelp" = "seagreen",
"California Sheephead" = "dodgerblue4",
"Purple Urchin" = "purple",
"Red Urchin" = "firebrick")) +
scale_fill_manual(values = c(
"Giant Kelp" = "seagreen",
"California Sheephead" = "dodgerblue4",
"Purple Urchin" = "purple",
"Red Urchin" = "firebrick")) +
# using labs to label axes
labs(
x = "Time (years)",
y = "Mean dry biomass (g/m^2)") +
# adding custom theme
theme_minimal() +
theme(legend.position = "NONE")
library(tidyverse) # general use
library(janitor) # cleaning data
library(here) # data organization
library(lubridate) # date and time
library(naniar) # to use gg_miss_var
# reading in biomass data
biomass <- read.csv(here("data",
"annual_all_species_fish.csv"),
# changing -99999 values to be na
na = "-99999")
# reading in bottom temperature data
bottom_temp <- read.csv(here("data", "Bottom_temp_all_years.csv"),
# changing -99999 values to be na
na = "-99999")
#| label: visualizing-missing-bottom-temp-data
# looking at the missing temperature data
temp_missing <- bottom_temp |>
# cleaning names
clean_names() |>
# selecting temperature
select(temp_c) |>
# using gg_miss_var to check for "na" data
gg_miss_var()
view(temp_missing)
#| label: cleaning-data
# BIOMASS
# creating new object, biomass_clean
biomass_clean <- biomass |>
# cleaning names
clean_names() |>
# filtering for desired species
filter(common_name %in% c("California Sheephead",
"Red Urchin",
"Purple Urchin",
"Giant Kelp")) |>
# renaming date
rename(original_date = date) |>
# using mutate and lubridate to convert original_date
# into new date column that can be used to create time series
mutate(
date = ymd(original_date),
year = floor_date(date, unit = "year")) |>
# dropping na values to use summarize
drop_na(dry_gm2) |>
# grouping data by year and species
group_by(year,
common_name) |>
# using summarize to get the mean dry biomass and make one row per year
summarize(mean_dry_gm2 = mean(dry_gm2)) |>
# ungrouping data
ungroup()
# BOTTOM TEMPERATURE
# creating new object to look at bottom temp data
bottom_temp_clean <- bottom_temp |>
# cleaning names
clean_names() |>
# using mutate and lubridate to convert date_local
# into new date column that can be used to create time series
mutate(
date = ymd(date_local),
year = floor_date(date, unit = "year")) |>
# grouping data by year
group_by(year) |>
# using summarize to get mean temp and make one row per year
summarize(mean_bottom_temp = mean(temp_c)) |>
# ungrouping the data
ungroup()
#| label: joining-datasets
# creating new object to join datasets
biomass_and_bottom_temp <- full_join(
biomass_clean,
bottom_temp_clean,
# joining datasets by year
by = c("year"))
#| label: biomass-timeseries
# base layer: ggplot
ggplot(data = biomass_clean,
# year on x axis, mean dry biomass on y
# coloring by species name
mapping = aes(x = year,
y = mean_dry_gm2,
fill = common_name,
color = common_name)) +
geom_area(alpha = 0.8) +
# second layer: geom_point
geom_line() +
# faceting by species
facet_wrap(~ common_name,
# letting y axis adjust for each species
scales = "free_y",
# putting in one column for better viewing
ncol = 1) +
# customizing x axis year labels for every 3 years
scale_x_date(date_breaks = "5 years",
date_labels = "%Y") +
# customizing colors
scale_color_manual(values = c(
"Giant Kelp" = "seagreen",
"California Sheephead" = "dodgerblue4",
"Purple Urchin" = "purple",
"Red Urchin" = "firebrick")) +
scale_fill_manual(values = c(
"Giant Kelp" = "seagreen",
"California Sheephead" = "dodgerblue4",
"Purple Urchin" = "purple",
"Red Urchin" = "firebrick")) +
# using labs to label axes
labs(
x = "Time (years)",
y = "Mean dry biomass (g/m^2)") +
# adding custom theme
theme_minimal() +
theme(legend.position = "NONE")
#| label: time-series-mean-bottom-temperature
# base layer: ggplot
ggplot(bottom_temp_clean) +
# x axis year, y axis mean temperature
aes(x = year,
y = mean_bottom_temp) +
# first layer: geom_line
# custom color for line
geom_line(color = "sienna2") +
# second layer: geom_point
# custom color and adjusting size
geom_point(
color = "sienna2",
size = 0.5) +
# customizing x axis year labels for every 3 years
scale_x_date(date_breaks = "5 years",
date_labels = "%Y") +
# using labs to label x and y axis
labs(
x = "Time (years)",
y = "Temperature (celcius)") +
# custom theme
theme_minimal()
#| label: cleaning-urchin-and-sheephead-data
# creating new object to look compare sheephead and urchin biomass
sheephead_and_urchin <- biomass |>
# clean names
clean_names() |>
# filtering by urchin and sheephead
filter(common_name %in% c("California Sheephead",
"Purple Urchin",
"Red Urchin")) |>
# renaming date for lubridate adjustment
rename(original_date = date) |>
# using mutate and lubridate to convert original_date
# into new date column to look at by year
mutate(
date = ymd(original_date),
year = floor_date(date, unit = "year")) |>
# dropping missing dry_gm2 values
drop_na(dry_gm2) |>
# grouping by year and common_name
group_by(year,
common_name) |>
# using summarize to find mean dry_gm2 and make one row per year
summarize(mean_dry_gm2 = mean(dry_gm2)) |>
# ungrouping
ungroup() |>
# using pivot_wider to look at CA sheephead and urchin as columns with values from mean_dry_gm2
pivot_wider(
names_from = common_name,
values_from = mean_dry_gm2) |>
# cleaning names
clean_names()
#| label: visualizing-urchin-and-sheephead-data
# base layer: ggplot
ggplot(sheephead_and_urchin) +
# looking at CA sheephead biomass on x axis, purple urchin on y
aes(x = california_sheephead) +
# second layer: geom_point
geom_point(aes(y = purple_urchin),
color = "purple") +
geom_point(aes(y = red_urchin),
color ="red") +
# using labs to label axes
labs(
x = "California sheephead mean dry biomass (g/m^2)",
y = "Urchin mean dry biomass (g/m^2)") +
# custom theme
theme_minimal()
#| message: false
#| warning: false
# loading in packages
library(tidyverse) # general use
library(janitor) # cleaning data
library(here) # data organization
# reading in data
# urchin density data from DiFiore et al. 2021
urchin <- read.csv(here("data","mesocosm_density_data.csv"))
#| label: urchin-data-cleaning
#| message: false
# create new object urchin_clean
urchin_clean <- urchin |>
# clean column names
clean_names() |>
# filter for trials with no mortality
filter(mortality == 0) |>
# mutate p_r to show the different species of urchins
rename(species = p_r) |>
mutate(species = case_when(
species == "p" ~ "Purple urchin",
species == "r" ~ "Red urchin"
)) |>
# grouping data for summarize
group_by(trial_id, tank, species, urchin_density, total_time, kelp_in, kelp_out) |>
# using summarize to create urchin_biomass
summarize(urchin_biomass = sum(urchin_mass)/1.587) |>
#ungrouping columns
ungroup() |>
# mutate kelp_in and kelp_out columns to the kelp foraging rate of the urchins
mutate(kelp_consumption_rate = ((kelp_in - kelp_out) / total_time)*24) |>
mutate(rate_per_urchin = (kelp_consumption_rate) / urchin_density) |>
# select for desired columns of interest
select(urchin_density, rate_per_urchin, species, total_time, kelp_consumption_rate, urchin_biomass)
#| label: visualization-of-urchin-density-rate
# base plot
ggplot(data = urchin_clean,
# x-axis urchin density, y-axis urchin consumption rate
# color by species
mapping = aes(x = urchin_density,
y = rate_per_urchin,
color = species)) +
# first layer: geom_point
geom_point(shape = 20,
alpha = 0.5,
size = 4) +
# separating by species
facet_wrap(~species) +
# customizing colors
scale_color_manual(values = c(
"Purple urchin" = "mediumorchid4",
"Red urchin" = "firebrick")) +
# labeling axes and adding title
labs(x = "Urchin density (per tank)",
y = "Kelp consumed (gd^-1) per urchin",
title = "Per-urchin foragaing rate on kelp \nacross different urchin densities") +
# adding custom theme
theme_minimal() +
# removing legend
theme(legend.position = "none")
#| label: visualization-of-kelp-consumption-rate
# base plot
ggplot(data = urchin_clean,
# x-axis urchin density, y-axis urchin consumption rate
# color by species
mapping = aes(x = urchin_biomass,
y = kelp_consumption_rate,
color = species)) +
# first layer: geom_point
geom_point(shape = 20,
alpha = 0.5,
size = 4) +
# separating by species
facet_wrap(~species) +
# customizing colors
scale_color_manual(values = c(
"Purple urchin" = "mediumorchid4",
"Red urchin" = "firebrick")) +
labs(x = "Urchin biomass (gm^-2)",
y = "Kelp consumption rate (gd^-1)",
title = "Kelp consumption rate versus urchin biomass") +
# adding custom theme
theme_minimal() +
# removing legend
theme(legend.position = "none")
#| label: visualization-of-urchin-density-rate
# base plot
ggplot(data = urchin_clean,
# x-axis urchin density, y-axis urchin consumption rate
# color by species
mapping = aes(x = urchin_density,
y = rate_per_urchin,
color = species)) +
# first layer: geom_point
geom_point(shape = 20,
alpha = 0.5,
size = 4) +
# separating by species
facet_wrap(~species) +
# customizing colors
scale_color_manual(values = c(
