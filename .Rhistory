# x-axis: time
aes(x = start_of_year,
# y-axis: abundance
y = mean_dry_gm2,
# coloring by species
color = common_name)) +
# first layer: geom_line
geom_line() +
# second layer: geom_point
geom_point(size = 0.5) +
