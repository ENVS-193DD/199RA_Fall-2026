# base layer: ggplot
ggplot(data = p_urchin_avg_biomass,
# x-axis: period, y-axis: sd_from_mean
mapping = aes(x = period,
y = z,
# coloring by period
color = period)) +
# first layer: geom_jitter
geom_jitter() +
scale_color_manual(values = c(
"Before" = "deepskyblue",
"During" = "darkorange",
"After" = "deepskyblue")) +
# custom theme
theme_minimal() +
# removing legend
theme(legend.position = "NONE")
