# species mean dry biomass  timeseries
ggplot(biomass_bottom_temp) +
aes(x = start_of_year,
y = mean_dry_gm2,
color = common_name) +
geom_line() +
geom_point(size = 0.5) +
scale_x_date(date_breaks = "3 years",
date_labels = "%Y") +
scale_color_manual(values = c(
"Giant Kelp" = "seagreen",
"California Sheephead" = "dodgerblue4",
"Purple Urchin" = "purple",
"Red Urchin" = "firebrick")) +
labs(
x = "Time (years)",
y = "Mean dry biomass (g/m^2)") +
theme_minimal() +
theme(legend.position = "NONE")
# time series mean temperature
ggplot(biomass_bottom_temp) +
aes(x = start_of_year,
# y-axis: abundance
y = mean_temp_c)+
# first layer: geom_line
geom_line(color = "sienna2") +
# second layer: geom_point
geom_point(
color = "sienna2",
size = 0.5) +
# faceting by species
scale_x_date(date_breaks = "3 years",
date_labels = "%Y") +
labs(
x = "Time (years)",
y = "Temperature (celcius)") +
theme_minimal()
