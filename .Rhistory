group_by(start_of_year,
temp_c,
site) |>
# summarize to make one row per month
# sum to get the mean dry mass for each species
summarize(mean_temp_c = mean(temp_c)) |>
# ungrouping the data
ungroup() |>
relocate(site, start_of_year, mean_temp_c)
biomass_bottom_temp <- full_join(
biomass_clean,
bottom_temp_clean,
by = c("site", "start_of_year"))
biomass_clean <- biomass |>
clean_names() |>
filter(common_name %in% c("California Sheephead", "Red Urchin", "Purple Urchin", "Giant Kelp")) |>
rename(original_date = date) |>
mutate(
date = ymd(original_date),
start_of_year = floor_date(date, unit = "year")) |>
drop_na() |>
group_by(start_of_year,
common_name,
site) |>
summarize(mean_dry_gm2 = mean(dry_gm2)) |>
# ungrouping the data
ungroup() |>
relocate(common_name, start_of_year, site, mean_dry_gm2)
bottom_temp_clean <- bottom_temp |>
clean_names() |>
mutate(
date = ymd(date_local),
start_of_year = floor_date(date, unit = "year")) |>
group_by(start_of_year,
temp_c,
site) |>
drop_na() |>
summarize(mean_temp_c = mean(temp_c)) |>
# ungrouping the data
ungroup() |>
relocate(site, start_of_year, mean_temp_c)
biomass_bottom_temp <- full_join(
biomass_clean,
bottom_temp_clean,
by = c("site", "start_of_year"))
View(biomass_bottom_temp)
