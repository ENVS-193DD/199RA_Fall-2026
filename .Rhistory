# species mean dry biomass timeseries FACET
# base layer: ggplot
ggplot(biomass_clean) +
# year on x axis, biomass on y axis, coloring by species
aes(x = year,
y = mean_dry_gm2,
color = common_name,
linetype = site) +
# first layer: geom_line
geom_line() +
# second layer: geom_point
geom_point(size = 0.5) +
# faceting by species
facet_wrap(~ common_name,
# letting y axis adjust for each species
scales = "free_y",
# putting in one column for better viewing
ncol = 1) +
# customizing x axis year labels for every 3 years
scale_x_date(date_breaks = "3 years",
date_labels = "%Y") +
# customizing colors
scale_color_manual(values = c(
"Giant Kelp" = "seagreen",
"California Sheephead" = "dodgerblue4",
"Purple Urchin" = "purple",
"Red Urchin" = "firebrick")) +
# using labs to label axes
labs(
x = "Time (years)",
y = "Mean dry biomass (g/m^2)") +
# adding custom theme
theme_minimal()
#| label: time-series-mean-bottom-temperature
# base layer: ggplot
ggplot(bottom_temp_clean) +
# x axis year, y axis mean temperature
aes(x = year,
y = mean_bottom_temp,
linetype = site) +
# first layer: geom_line
# custom color for line
geom_line(color = "sienna2") +
# second layer: geom_point
# custom color and adjusting size
geom_point(
color = "sienna2",
size = 0.5) +
# customizing x axis year labels for every 3 years
scale_x_date(date_breaks = "3 years",
date_labels = "%Y") +
# using labs to label x and y axis
labs(
x = "Time (years)",
y = "Temperature (celcius)") +
# custom theme
theme_minimal()
# base layer: ggplot
biomass_bottom_temp |>
filter(common_name == "California Sheephead") |>
ggplot(biomass_and_bottom_temp) +
# x axis year, y axis mean temperature
aes(x = mean_bottom_temp,
y = mean_dry_gm2,
linetype = site) +
